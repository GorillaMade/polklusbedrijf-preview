---
import '../../sass/global.scss';
import { site } from '@/config/site';
import { business } from '@/data/business';
import BaseHead from '@/components/utility/BaseHead.astro';
import JsonLd from '@/components/utility/JsonLd.astro';
import SkipLink from '@/components/global/SkipLink.astro';
import Header from '@/components/global/Header.astro';
import SiteNav from '@/components/global/SiteNav.astro';
import SiteNavLink from '@/components/global/SiteNavLink.astro';
import Footer from '@/components/global/Footer.astro';
import Button from '@/components/Button.astro';
import Nav from '@/components/global/Nav.astro';
import NavLink from '@/components/global/NavLink.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description, noindex } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', name: site.name, url: site.url, description: site.description, address: { '@type': 'PostalAddress', addressLocality: 'Waalwijk', addressCountry: 'NL' }, areaServed: 'Waalwijk en omgeving' };
---
<!doctype html>
<html lang="nl" data-theme="light">

  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <JsonLd data={schema} />
    <slot name="head" />
  </head>

  <body>
    <SkipLink href="#main">Ga naar inhoud</SkipLink>
    <div class="topline"><span>POL KLUSBEDRIJF · VAKWERK MET AANDACHT</span><span>WAALWIJK & OMGEVING</span></div>
    <Header position="sticky" class="pol-header">
      <a slot="brand" href="/" class="pol-logo" aria-label="Pol Klusbedrijf, naar home">
        <img src="/images/pol-klusbedrijf-logo.svg" alt="Pol Klusbedrijf" width="64" height="64" />
        <span class="pol-logo__type">POL <b>KLUSBEDRIJF</b><small>VAKWERK OP MAAT</small></span>
      </a>
      <SiteNav slot="navigation" id="site-navigation" label="Hoofdnavigatie">
        <SiteNavLink href="/#diensten">Diensten</SiteNavLink>
        <SiteNavLink href="/projects" activeSection="projecten">Projecten</SiteNavLink>
        <SiteNavLink href="/#werkwijze">Werkwijze</SiteNavLink>
        <SiteNavLink href="/#over">Over Pol</SiteNavLink>
        <SiteNavLink href="/contact">Contact</SiteNavLink>
        <Button href="/offerte" class="nav-cta">Vraag een offerte aan ↗</Button>
      </SiteNav>
    </Header>
    <main id="main">
      <slot />
    </main>
    <Footer theme="dark" copyright="Pol Klusbedrijf">
      <div slot="brand" class="footer-intro">
        <a slot="brand" href="/" class="pol-logo" aria-label="Pol Klusbedrijf, naar home">
          <img src="/images/pol-klusbedrijf-logo-light.svg" alt="Pol Klusbedrijf" width="64" height="64" />
          <span class="pol-logo__type">POL <b>KLUSBEDRIJF</b><small>VAKWERK OP MAAT</small></span>
        </a>
        <p>Geen klus is hetzelfde. Daarom leveren we werk op maat, met aandacht voor het resultaat én de details.</p><span>Waalwijk en omgeving</span>
      </div>
      <div slot="company" class="footer-links"><strong>Ontdek</strong>
        <Nav direction="vertical">
          <NavLink href="/#over">Over Pol</NavLink>
          <NavLink href="/projects">Ons werk</NavLink>
          <NavLink href="/#werkwijze">Onze aanpak</NavLink>
          <NavLink href="/offerte">Offerte aanvragen</NavLink>
        </Nav>
      </div>
      <div slot="services" class="footer-links"><strong>Expertise</strong>
        <Nav direction="vertical">
          <NavLink href="/#diensten">Timmerwerk</NavLink>
          <NavLink href="/#diensten">Traprenovatie</NavLink>
          <NavLink href="/#diensten">Schilderwerk</NavLink>
          <NavLink href="/#diensten">Deuren & kozijnen</NavLink>
        </Nav>
      </div>
      <div slot="contact" class="footer-links">
        <strong>Contact</strong>

        <span>{business.location}</span>

        <a href={business.phone.href}>
          {business.phone.display}
        </a>

        <a href={business.quoteUrl}>
          Vertel ons over uw klus ↗
        </a>
      </div>
      <div slot="legal" class="footer-legal">
        <a href="/privacy">Privacy</a>
        <a href="/algemene-voorwaarden/" rel="noopener noreferrer">Algemene voorwaarden</a>
      </div>
    </Footer>
  </body>

</html>

<style is:global lang="scss">
  /* Stijlen verplaatst vanuit sass/pol.scss; bestaande selectors behouden. */
  // Pol Klusbedrijf — project-specific layer built on GorillaMade tokens.
  [x-cloak] {
    display: none !important;
  }

  :root {
    --pol-navy: #102a43;
    --pol-orange: #f47b20;
    --pol-cream: #f6f7f5;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  .site-container {
    width: min(100% - 2 * clamp(1.25rem, 5vw, 6rem), 1420px);
    margin-inline: auto;
  }

  .topline {
    display: flex;
    justify-content: space-between;
    padding: .65rem clamp(1.25rem, 5vw, 6rem);
    background: #102a43;
    color: #b7c7d3;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .16em;
  }

  .topline__dot {
    color: #f47b20;
    padding-inline: .7rem;
  }

  .pol-header {
    --surface-page: #fff;
  }

  .pol-header .site-header__inner {
    padding-inline: clamp(1.25rem, 5vw, 6rem);
  }

  .pol-logo {
    display: flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .pol-logo__mark {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    font-size: 2rem;
    line-height: 1;
    font-weight: 950;
    letter-spacing: -.13em;
    background: #102a43;
    color: white;
    border-radius: 3px;
  }

  .pol-logo__mark span,
  .footer-wordmark span {
    color: #f47b20;
  }

  .pol-logo__type {
    font-weight: 950;
    letter-spacing: .03em;
    font-size: 1.05rem;
    line-height: 1.05;
  }

  .pol-logo__type b {
    font-weight: 650;
  }

  .pol-logo__type small {
    display: block;
    font-size: .53rem;
    font-weight: 700;
    letter-spacing: .25em;
    margin-top: .35rem;
    color: #6b8194;
  }

  .eyeline {
    display: flex;
    align-items: center;
    gap: .85rem;
    color: #ba5b17;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .17em;
    text-transform: uppercase;
    margin: 0 0 1.75rem;
  }

  .eyeline--light {
    color: #f9ad74;
  }

  .eyeline__line {
    width: 2rem;
    height: 2px;
    background: currentColor;
    flex: none;
  }

  .display-heading {
    color: #102a43;
    font-size: clamp(2.8rem, 6vw, 6.1rem);
    letter-spacing: -.065em;
    line-height: 1.03;
    font-weight: 850;
    margin: 0;
  }

  .display-heading em {
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -.055em;
  }

  .section-space {
    padding-block: clamp(5rem, 9vw, 10rem);
  }

  .text-link {
    display: inline-flex;
    gap: 3rem;
    align-items: center;
    text-decoration: none;
    border-bottom: 1px solid #102a43;
    padding-bottom: .55rem;
    color: #102a43;
    font-weight: 800;
  }

  .text-link span {
    font-size: 1.4rem;
  }

  .text-link--light {
    color: white;
    border-color: #ffffff80;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .footer-intro p {
    max-width: 300px;
    line-height: 1.7;
    color: #b7c7d3;
  }

  .footer-intro>span {
    color: #f47b20;
    font-size: .75rem;
    font-weight: 800;
  }

  .footer-wordmark {
    color: white;
    text-decoration: none;
    font-size: 3.3rem;
    letter-spacing: -.09em;
    font-weight: 950;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .85rem;
  }

  .footer-links strong {
    color: white;
    margin-bottom: .6rem;
  }

  .footer-links a,
  .footer-links span {
    color: #b7c7d3;
    text-decoration: none;
    font-size: .95rem;
  }

  .footer-links a:hover,
  .footer-legal a:hover {
    color: #f47b20;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-legal a {
    color: #b7c7d3;
    text-decoration: none;
    font-size: .8rem;
  }

  .simple-page {
    padding-block: clamp(5rem, 10vw, 10rem);
    max-width: 950px;
  }

  .simple-page>p {
    max-width: 690px;
    line-height: 1.8;
    color: #526d84;
    font-size: 1.1rem;
  }

  .simple-page .pol-button {
    margin-top: 2rem;
  }

  // Quote wizard
  .quote-page {
    background: #F3F6F8;
  }

  @media (max-width: 976px) {
    .topline {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .projects__grid {
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media (prefers-reduced-motion:reduce) {

    *,
    *::before,
    *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
  }

  // -----------------------------------------------------------------------------
  // Project overview and detail
  // -----------------------------------------------------------------------------
  .project-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  // Component composition: preserve Pol layouts when using starter wrappers.
  .site-container.wrapper {
    width: min(100% - 2 * clamp(1.25rem, 5vw, 6rem), 1420px);
    max-width: none;
    margin-inline: auto;
  }

  .projects__grid.grid {
    display: grid;
  }

  .projects__grid.grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 976px) {
    .projects__grid.grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .projects__grid.grid {
      grid-template-columns: 1fr;
    }
  }

  // Component integration: keep the existing Pol styling with shared primitives.
  .wizard-step.fieldset>legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
